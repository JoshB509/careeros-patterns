{
  "manifestVersion": 5,
  "id": "com.careeros.dajoshicut",
  "name": "Josh Cut Pro",
  "version": "0.9.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "dajoshiCutPanel",
      "label": {
        "default": "Josh Cut Pro"
      },
      "minimumSize": {
        "width": 200,
        "height": 110
      },
      "maximumSize": {
        "width": 2000,
        "height": 4000
      },
      "preferredDockedSize": {
        "width": 260,
        "height": 130
      },
      "preferredFloatingSize": {
        "width": 280,
        "height": 140
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "all"
          ],
          "species": [
            "chrome"
          ]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "all"
      ],
      "species": [
        "pluginList"
      ]
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "localFileSystem": "request",
    "launchProcess": {
      "schemes": [
        "http",
        "https"
      ],
      "extensions": [
        ".bat"
      ]
    }
  }
}